# Copy to .env and fill in values from your Supabase project
# (Project Settings -> API). Vite only exposes VITE_-prefixed vars to the
# client bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by scripts/seed.js (a trusted local/CI script) — never exposed
# to the browser. Get it from Project Settings -> API -> service_role.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SEED_DEMO_PASSWORD=WorkSync-Demo-2026!
