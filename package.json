{
  "name": "task-management",
  "version": "1.0.0",
  "private": true,
  "description": "Task management app scaffold: static HTML/JS + Tailwind CSS + Supabase, deployed on Vercel.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --minify",
    "build:config": "node ./scripts/generate-config.js",
    "build:vendor": "mkdir -p public/js/vendor && cp node_modules/@supabase/supabase-js/dist/umd/supabase.js public/js/vendor/supabase.js",
    "build": "npm run build:config && npm run build:css && npm run build:vendor",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --watch",
    "serve": "node ./scripts/serve.js"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "tailwindcss": "^3.4.13"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3"
  }
}
